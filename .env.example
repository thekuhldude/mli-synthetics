OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_DESIGNER=llama3.1:8b
OLLAMA_MODEL_ANALYZER=llama3.1:8b
OLLAMA_TIMEOUT_SECONDS=600

DESIGNER_TEMPERATURE=0.7
ANALYZER_TEMPERATURE=0.3

# Anthropic API backend (set USE_ANTHROPIC=true to activate)
ANTHROPIC_API_KEY=your-key-here
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
USE_ANTHROPIC=false

# Groq API backend (set USE_GROQ=true to activate)
GROQ_API_KEY=your-key-here
GROQ_MODEL=llama-3.1-70b-versatile
USE_GROQ=false
